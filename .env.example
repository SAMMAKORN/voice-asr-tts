# ทุกค่าตัวเลขในไฟล์นี้ถูกตรวจตอนเปิดโปรแกรม (vc/config.py):
#   · ใส่ตัวอักษรในช่องตัวเลข = หยุดทันทีพร้อมบอกชื่อ key และช่วงที่ยอมรับ
#   · ใส่ค่านอกช่วง = บีบเข้าช่วงใกล้สุดพร้อม WARNING แล้วรันต่อ
#   · ค่าในไฟล์นี้ทั้งหมดผ่านการตรวจแล้วว่าไม่มี WARNING ใด ๆ

# ━━ API (ต้องระบุทั้งสองค่า) ━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Base URL ของ LiteLLM proxy หรือ API Gateway
API_BASE_URL=https://litellm.domain.ai
# API Key สำหรับเข้าถึง
API_KEY=your-api-key-here

# ━━ โมเดล ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# LLM สำหรับสนทนา (chat completion)
CHAT_MODEL=qwen/qwen3.6-27b
# ASR (Automatic Speech Recognition) — แปลงเสียงเป็นข้อความ
ASR_MODEL=qwen/qwen3-asr-1.7b
# TTS (Text-to-Speech) — แปลงข้อความเป็นเสียง
TTS_MODEL=k2-fsa/OmniVoice

# ━━ LLM สำหรับสนทนา ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Temperature: 0 = ตอบตรงที่สุด, 1 = มีความหลากหลาย
CHAT_TEMPERATURE=0.6
# จำนวน token สูงสุดที่ตอบต่อครั้ง — เป็นเพดานฝั่งโมเดล (กันคำตอบยาวจนเปลืองเวลา)
# เพดานที่ผู้ใช้ได้ยินจริงถูกบังคับอีกชั้นด้วย REPLY_MAX_CHARS/REPLY_MAX_SENTENCES
# ข้างล่าง จึงตั้งค่านี้ให้ "หลวมกว่า" เพดานนั้นเสมอ (350 token ≈ 400-600 ตัวอักษรไทย)
CHAT_MAX_TOKENS=350

# ━━ ความยาวคำตอบ (บังคับในโค้ด ไม่พึ่ง prompt) ━━━━━━━━━
# วัดจากบันทึกจริง 126 ข้อความ: p90 = 366 ตัวอักษร ยาวสุด 815 ทั้งที่ prompt สั่ง
# ไม่เกิน 4 ประโยค → prompt เดียวเอาไม่อยู่ ระบบจึงตัดสตรีมเองที่ขอบประโยค
# ตัดเมื่อถึงอย่างใดอย่างหนึ่งก่อน · ปิดเพดานประโยค = 0 · ปิดเพดานตัวอักษร = ตั้งสูงมาก
REPLY_MAX_SENTENCES=4
REPLY_MAX_CHARS=320

# ━━ ความทนทานเวลาเน็ตกระตุก ━━━━━━━━━━━━━━━━━━━━━━━━━━
# ลองใหม่กี่ครั้งเมื่อเชื่อมต่อไม่ได้ / timeout / HTTP 429 / HTTP 5xx (ไม่รวมครั้งแรก)
# 4xx อื่น ๆ ไม่ลองใหม่ และสตรีมคำตอบจะลองใหม่ได้เฉพาะก่อนที่ token แรกจะออก
HTTP_RETRY_MAX=2
# ฐานของ exponential backoff: ครั้งที่ 1 รอ ~300ms, ครั้งที่ 2 รอ ~600ms (มี jitter ±20%)
# ถ้าเซิร์ฟเวอร์ส่ง Retry-After มา จะใช้ค่านั้นแทน
HTTP_RETRY_BASE_MS=300
# จำนวนผลค้นเว็บย้อนหลังที่คงไว้ให้โมเดลอ้างอิงได้โดยไม่ต้องค้นซ้ำ
KEEP_FINDINGS=4

# ━━ ภาษา / บุคลิก ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ภาษาหลักรองใบ้ ASR (th, en, ja, …)
LANG_HINT=th
# System prompt กำหนดบุคลิก AI — ทิ้งว่างเพื่อใช้ค่าเริ่มต้น
# SYSTEM_PROMPT=คุณเป็นผู้ช่วย AI ที่คุยด้วยเสียง…

# ━━ เสียงพูดของ AI ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 0 = พูดไปพร้อมกับที่ข้อความกำลังไหล (เริ่มพูดเร็ว เป็นธรรมชาติกว่า)
# 1 = รอคำตอบจบแล้วยิงทีเดียว เสียงเป็นคนเดียวกันทั้งคำตอบ แต่เริ่มพูดช้ากว่า
# ล็อกเสียงให้คงที่ข้ามก้อนไม่ได้: OmniVoice ผ่าน vLLM รองรับแค่ auto voice
# และเสียงถูกกำหนดจากตัวข้อความ (ทดสอบแล้ว: ส่ง voice= ได้ 500, seed/speaker ถูกเมิน,
# เติมคำนำหน้าเดิมทุกก้อนก็ไม่ช่วย) และ TTS ไม่สตรีมเสียงระหว่างสังเคราะห์ด้วย
TTS_SINGLE_REQUEST=0
# ก้อนแรกสั้นเพื่อให้เริ่มพูดเร็ว แล้วก้อนถัด ๆ ไปโตขึ้นเรื่อย ๆ เพื่อลดจำนวนครั้ง
# ที่เสียงเปลี่ยนคน โดยยังต้องสังเคราะห์ทันก่อนก้อนก่อนหน้าจะเล่นจบ ไม่งั้นเสียงขาดช่วง
TTS_FIRST_CHARS=24
TTS_CHUNK_CHARS=60
TTS_CHUNK_GROWTH=1.8
# เพดานตัวอักษรต่อหนึ่ง request (วัดจริง: 233 ตัวอักษร = 4.8 วิ แต่ 389 = 14.2 วิ)
TTS_MAX_CHARS=260
# พูด "ขอค้นข้อมูลสักครู่นะครับ" ระหว่างค้นเน็ต กันเงียบหายตอนรอผลค้น
TTS_SEARCH_FILLER=1

# ━━ จูนไมโครโฟน / การขัดจังหวะ ━━━━━━━━━━━━━━━━━━━━━━━
# ขยายเสียงไมค์ฝั่งซอฟต์แวร์ ชดเชยกรณี input volume ของเครื่องถูกหรี่ไว้
# 0 = คำนวณเองจากเสียงรบกวนที่วัดได้ตอนเริ่ม (ดูค่าจริงด้วย --mic-check)
MIC_GAIN=0
MIC_TARGET_NOISE=0.0035
# ระดับเสียงขั้นต่ำที่นับว่าเป็นเสียงพูด (0-1)
VAD_ABS_THRESHOLD=0.012
# ตัวคูณเหนือระดับเสียงรบกวนรอบข้าง
VAD_NOISE_MULT=3.2
# ต้องพูดต่อเนื่องกี่มิลลิวินาทีจึงเริ่มอัด (ตอนเงียบ / ตอน AI พูด)
VAD_CONFIRM_MS=120
VAD_CONFIRM_MS_PLAYBACK=340
# เงียบต่อเนื่องกี่มิลลิวินาทีถือว่าเป็นพูดจบ
VAD_END_SILENCE_MS=650
# ความยาวคำพูดต่ำสุด / สูงสุด (มิลลิวินาที)
VAD_MIN_UTTERANCE_MS=350
VAD_MAX_UTTERANCE_MS=25000
# กันไมค์ได้ยินเสียงลำโพงตัวเอง (ปิดได้ด้วย --headphones)
ECHO_GUARD=1
# Margin ของ echo guard (เท่าของเสียงลำโพงที่รั่วเข้าไมค์)
ECHO_MARGIN=3.5
# ถอดเสียงได้สั้นกว่านี้ = ถือว่าไม่ใช่คนพูดจริง ไม่ตัดคำตอบทิ้ง
BARGE_IN_MIN_CHARS=2

# ━━ ค้นข้อมูลจากอินเทอร์เน็ต ━━━━━━━━━━━━━━━━━━━━━━━━━━━
# เปิด/ปิดการค้นเน็ต (ปิดได้ด้วย --no-web)
WEB_SEARCH=1
# จำนวนผลค้นหาที่ส่งให้โมเดล
SEARCH_RESULTS=5
# วินาทีที่ยอมรอผลค้นหา / เปิดหน้าเว็บ
SEARCH_TIMEOUT=12.0
# ความยาวเนื้อหาหน้าเว็บสูงสุดที่ส่งให้โมเดล (ตัวอักษร)
FETCH_MAX_CHARS=3000
# เพดานไบต์ที่ยอมดาวน์โหลดต่อหนึ่งหน้า — เกินนี้จะหยุดอ่านและปิดการเชื่อมต่อทันที
FETCH_MAX_BYTES=512000
# จำนวนรอบสูงสุดที่ยอมให้เรียกเครื่องมือต่อหนึ่งคำถาม
TOOL_ROUNDS=2

# ━━ เขตเวลา ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ใช้ทั้งการบอกวันเวลาปัจจุบันให้โมเดล และการตั้งชื่อ/ปั๊มเวลาในบันทึก
# ไม่ตั้ง = Asia/Bangkok (ไม่พึ่ง TZ ของเครื่อง เพราะ container ส่วนใหญ่เป็น UTC)
APP_TZ=Asia/Bangkok

# ━━ บันทึกการสนทนา (ข้อมูลอ่อนไหว) ━━━━━━━━━━━━━━━━━━━━
# ที่เก็บบันทึก — ใส่ path สัมพัทธ์ได้ (อ้างจากรากโปรเจกต์) ไม่ตั้ง = ./logs
# โฟลเดอร์ที่สร้างใหม่เป็นสิทธิ์ 700 และไฟล์เป็น 600 (เจ้าของเครื่องอ่านได้คนเดียว)
#LOG_DIR=./logs
# 1 = เก็บคำพูดทั้งหมด (transcript.md + ข้อความใน session.jsonl)
# 0 = ไม่เขียนคำพูดลงดิสก์เลย เหลือแต่ตัวเลข latency/ขนาด และไม่เก็บไฟล์เสียงด้วย
LOG_TRANSCRIPT=1
# ลบ session ที่เก่ากว่ากี่วันตอนเริ่มโปรแกรม — 0 = ไม่ลบอะไรเลย (ค่าเริ่มต้น)
# ตั้งเป็นตัวเลข เช่น 7 เมื่อต้องการให้ระบบล้างบันทึกเก่าให้เอง (ลบแล้วกู้ไม่ได้)
LOG_RETENTION_DAYS=0

# ━━ ความปลอดภัยของโหมดเว็บ (web/server.py) ━━━━━━━━━━━━━
# รายชื่อ origin ที่ยอมให้ต่อ WebSocket/เรียก /api (คั่นด้วยจุลภาค)
# ไม่ตั้ง = ยอมเฉพาะ http://127.0.0.1:<พอร์ต> และ http://localhost:<พอร์ต> เท่านั้น
# ตั้งเองเมื่อเปิดผ่านชื่อโดเมน/HTTPS เช่น WEB_ALLOWED_ORIGINS=https://voice.example.com
#WEB_ALLOWED_ORIGINS=
# token ประจำเซิร์ฟเวอร์ ไม่ตั้ง = สุ่มใหม่ทุกครั้งที่เปิด (พอสำหรับใช้งานบนเครื่องตัวเอง)
# ต้องตั้งเองเมื่อรัน --host 0.0.0.0 หรือรันหลาย worker เพื่อให้ token คงที่
#WEB_AUTH_TOKEN=
